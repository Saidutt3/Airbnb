<% layout("/layouts/boilerplate") %>

    <body>
        <h3>All Listings</h3>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for (let listing of allListings) { %>
                <div class="col mb-4">
                    <div class="card" style="width: 20rem;">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <img class="card-img-top" style="height: 20rem;"
                                src="<%= listing.image || 'https://unsplash.com/photos/a-living-room-with-a-person-walking-in-the-distance-GUp3_kzq0Ts' %>"
                                alt="Listing Image">
                            <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b><br>
                                    &#8377; <%= listing.price %>/night
                                </p>
                            </div>
                        </a>
                    </div>
                </div>
                <% } %>
        </div>


    </body>


    </ul>
    </body>